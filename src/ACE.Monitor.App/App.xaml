<Application x:Class="ACE.Monitor.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Bg0">#0B1020</Color>
      <Color x:Key="Bg1">#111A32</Color>
      <Color x:Key="Card">#18243F</Color>
      <Color x:Key="Accent">#64D2FF</Color>
      <Color x:Key="Accent2">#8A7CFF</Color>
      <Color x:Key="Good">#51E3A4</Color>
      <Color x:Key="Warn">#FFD166</Color>
      <Color x:Key="TextMain">#F4F7FB</Color>
      <Color x:Key="TextMuted">#9AABC8</Color>
      <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}" />
      <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
      <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
      <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2}" />
      <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource Good}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}" />
      <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="14" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Background" Value="#22304F"/>
        <Setter Property="BorderBrush" Value="#32476F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Margin" Value="0,6"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
