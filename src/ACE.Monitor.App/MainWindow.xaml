<Window x:Class="ACE.Monitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACE Monitor" Height="720" Width="1060" MinHeight="650" MinWidth="960"
        Background="{StaticResource Bg0Brush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1020" Offset="0"/>
        <GradientStop Color="#111A32" Offset="0.55"/>
        <GradientStop Color="#14142B" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border CornerRadius="28" Padding="28" Margin="0,0,0,20">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#263B67" Offset="0"/>
            <GradientStop Color="#1A2850" Offset="0.55"/>
            <GradientStop Color="#412B72" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="🛡️ ACE Monitor" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Text="Windows 桌面版 · 仅监控 3 个 ACE 进程 · 开机自启后最小化运行" Margin="0,8,0,0" FontSize="15" Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#22304F" CornerRadius="18" Padding="18,12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource WarnBrush}" Margin="0,0,10,0"/>
              <TextBlock x:Name="StatusText" Text="未运行" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource CardBrush}" CornerRadius="24" Padding="24">
          <StackPanel>
            <TextBlock Text="控制中心" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Text="建议保持管理员权限运行，否则无法修改部分进程。" Margin="0,6,0,20" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>

            <TextBlock Text="扫描间隔（秒）" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBox x:Name="IntervalBox" Text="30" Margin="0,8,0,16"/>

            <CheckBox x:Name="PriorityCheck" Content="降低进程优先级为 Idle" IsChecked="True"/>
            <CheckBox x:Name="CpuCheck" Content="限制为单 CPU 核心（核心 0）" IsChecked="True"/>
            <CheckBox x:Name="StartupCheck" Content="开机自启（任务计划程序，最高权限）" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>

            <UniformGrid Columns="2" Margin="0,24,0,0">
              <Button x:Name="StartButton" Content="开始监控" Background="{StaticResource Accent2Brush}" Click="StartButton_Click" Margin="0,0,8,0"/>
              <Button x:Name="StopButton" Content="停止" Background="#33415F" Click="StopButton_Click" Margin="8,0,0,0"/>
            </UniformGrid>

            <Button Content="打开日志目录" Background="#22304F" Click="OpenLogsButton_Click" Margin="0,14,0,0"/>

            <Border Background="#111A32" CornerRadius="18" Padding="18" Margin="0,24,0,0">
              <StackPanel>
                <TextBlock Text="监控进程" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22"><Run Text="SGuard64, SGuardSvc64, ACE-GuardClient"/></TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="135"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <UniformGrid Columns="3">
            <Border Background="{StaticResource CardBrush}" CornerRadius="24" Padding="22" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="本轮发现" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="FoundCountText" Text="0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="24" Padding="22" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="最后扫描" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="LastScanText" Text="--:--:--" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,16,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="24" Padding="22" Margin="12,0,0,0">
              <StackPanel>
                <TextBlock Text="限制策略" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="Idle + 单核" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GoodBrush}" Margin="0,18,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="24" Padding="20">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="运行日志" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,14"/>
              <ListBox x:Name="LogList" Grid.Row="1" Background="#111A32" Foreground="{StaticResource TextMainBrush}" BorderThickness="0" Padding="10"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
